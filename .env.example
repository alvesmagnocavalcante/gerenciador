# Gere SECRET_KEY e API_KEY separadamente com:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Sem Python local, use o comando Docker documentado no README.
SECRET_KEY=
# Usada somente para criar o primeiro administrador ou substituir a senha legada.
# Mínimo: 8 caracteres.
ADMIN_PASSWORD=
ADMIN_USERNAME=admin
# Necessária para a API e para agentes remotos. Use um valor diferente de SECRET_KEY.
API_KEY=
DEBUG=false
TIMEZONE=America/Sao_Paulo
RUN_SCHEDULER_IN_WEB=true
MAX_CONCURRENT_EXECUTIONS=5
DEFAULT_TIMEOUT_SECONDS=3600
MAX_LOG_SIZE_BYTES=5242880
EXECUTION_LEASE_SECONDS=120
HEARTBEAT_INTERVAL_SECONDS=5
