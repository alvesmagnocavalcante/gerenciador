# SECRET_KEY e API_KEY são geradas e persistidas quando ficam vazias.
# Defina-as apenas se as credenciais forem gerenciadas externamente.
SECRET_KEY=
# Usada somente para criar o primeiro administrador ou substituir a senha legada.
# Mínimo: 8 caracteres.
ADMIN_PASSWORD=
ADMIN_USERNAME=admin
# Opcional: se definida, use um valor diferente de SECRET_KEY.
API_KEY=
# Opcional: substitui o token de primeiro acesso salvo no volume.
SETUP_TOKEN=
DEBUG=false
TIMEZONE=America/Sao_Paulo
RUN_SCHEDULER_IN_WEB=true
MAX_CONCURRENT_EXECUTIONS=5
DEFAULT_TIMEOUT_SECONDS=3600
MAX_LOG_SIZE_BYTES=5242880
EXECUTION_LEASE_SECONDS=120
HEARTBEAT_INTERVAL_SECONDS=5
